node_modules/
.next/
out/
build/
dist/

# ============================================================================
# Caches — large and fully regenerable, never commit
# ============================================================================
# fastf1's race-data cache. ~3.1 GB. It refills itself on demand; committing it
# would make the repo unusable.
f1-dashboard/backend/cache/
# Scratch dir the hero-frame encoder creates and deletes
.hero-frames-tmp/
.turbo/
*.tsbuildinfo

