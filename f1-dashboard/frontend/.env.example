# Copy to .env.local. Both are NEXT_PUBLIC_* — they are inlined into the client
# bundle at build time, so never put a real secret in this file.

# Where the FastAPI backend lives. Leave as-is for local development.
# NOTE: resolveBackendUrl() in lib/constants.ts checks the browser hostname
# BEFORE this value, so a remote visitor is not sent to their own localhost.
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000

NEXT_PUBLIC_OPENF1_URL=https://api.openf1.org/v1

# No map token is needed. /schedule renders satellite imagery through MapLibre
# with keyless Esri tiles — there is no account to create and no card to add.
